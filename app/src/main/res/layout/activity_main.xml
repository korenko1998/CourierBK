<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EBDC"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="18dp"
    android:paddingBottom="20dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Courier BK"
        android:textColor="#502314"
        android:textSize="30sp"
        android:textStyle="bold"
        android:fontFamily="sans"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Доставка • Работаем быстро"
        android:textColor="#8A6658"
        android:textSize="13sp"
        android:fontFamily="sans"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/settingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="⚙"
        android:textColor="#502314"
        android:textSize="25sp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/dateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="07 сентября 2026"
        android:textColor="#502314"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="sans"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/timeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"
        android:text="19:30"
        android:textColor="#502314"
        android:textSize="48sp"
        android:textStyle="bold"
        android:fontFamily="sans"
        app:layout_constraintTop_toBottomOf="@id/dateText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/courierCard"
        android:layout_width="0dp"
        android:layout_height="185dp"
        android:layout_marginTop="18dp"
        app:cardBackgroundColor="#FFE3BD"
        app:cardCornerRadius="28dp"
        app:cardElevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/timeText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/courierIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛵"
                android:textSize="82sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:text="Готовы к доставке?"
                android:textColor="#502314"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/actionHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="Нажмите, чтобы начать рабочую смену"
        android:textColor="#806D63"
        android:textSize="13sp"
        android:fontFamily="sans"
        app:layout_constraintTop_toBottomOf="@id/courierCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/startShiftButton"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_marginTop="15dp"
        android:text="▶\nНАЧАТЬ\nСМЕНУ"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:fontFamily="sans"
        android:padding="0dp"
        android:elevation="8dp"
        android:stateListAnimator="@null"
        android:backgroundTint="#D62300"
        app:layout_constraintTop_toBottomOf="@id/actionHint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="●  Смена не начата"
        android:textColor="#806D63"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="sans"
        app:layout_constraintTop_toBottomOf="@id/startShiftButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>